# Copy to .env and fill in. .env is gitignored — never commit it.

# Resend API key — dashboard → API Keys → Create (give it "Sending access").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Your audience/segment ID — dashboard → Audiences → (your list) → it's in the URL / details.
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# From address on a domain you've verified in Resend.
RESEND_FROM=ben-mini <ben@ben-mini.com>

# Optional: where replies go (defaults to the From address if omitted).
RESEND_REPLY_TO=ben@ben-mini.com

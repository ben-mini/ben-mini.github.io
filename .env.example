# Copy to .env and fill in. .env is gitignored — never commit it.

# Resend API key — dashboard → API Keys → Create with FULL ACCESS
# (Broadcasts need full access; "Sending access" only is not enough).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Your Segment ID — dashboard → Audience → Segments → create/open one → it's in the URL
# (resend.com/segments/THIS-ID). "Segment" is Resend's new name for an audience/list.
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# From address on a domain you've verified in Resend.
RESEND_FROM=name <email@email.com>

# Optional: where replies go (defaults to the From address if omitted).
RESEND_REPLY_TO=email@email.com
